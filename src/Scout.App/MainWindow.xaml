<Window x:Class="Scout.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Scout" Width="720" Height="565" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown" Background="#F4F7FB">
  <Border BorderBrush="#B9CADD" BorderThickness="1" Padding="22,16,22,12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel MouseLeftButtonDown="DragHeader">
        <StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="23" Foreground="{StaticResource Accent}" Margin="0,0,8,0"/><TextBlock Text="Scout" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
        <Button Content="Settings" Click="SettingsClick" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="10,5" AutomationProperties.Name="Open settings"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,20,0,12">
        <TextBox x:Name="Query" FontSize="24" BorderThickness="0,0,0,2" Background="Transparent" Padding="0,7,0,12" TextChanged="QueryChanged" AutomationProperties.Name="Search apps, files and links"/>
        <TextBlock x:Name="Placeholder" Text="What are you looking for?" Foreground="#71849A" FontSize="24" Margin="0,7,0,0" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel Grid.Row="2" x:Name="Scopes" Orientation="Horizontal" Margin="-3,0,0,10">
        <Button Content="All" Tag="0" Click="ScopeClick"/><Button Content="Files" Tag="1" Click="ScopeClick"/><Button Content="Apps" Tag="2" Click="ScopeClick"/><Button Content="Links" Tag="3" Click="ScopeClick"/><Button Content="Workspaces" Tag="4" Click="ScopeClick"/>
      </StackPanel>
      <Grid Grid.Row="3">
        <ListBox x:Name="Results" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SelectionChanged" PreviewMouseLeftButtonDown="ResultMouseDown" MouseDoubleClick="OpenDoubleClick" AutomationProperties.Name="Search results">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DDEBFC"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#91B8EB"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Evidence}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" Visibility="{Binding GlyphVisibility}" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}" FontSize="19" VerticalAlignment="Center"/>
                <Image Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Marker}" Margin="12,0,0,0" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="3" Visibility="{Binding MembershipVisibility}" IsChecked="{Binding Grouped, Mode=OneWay}" Click="MemberClick" VerticalAlignment="Center" Margin="10,0,0,0" AutomationProperties.Name="Include in group"/>
                <TextBlock Grid.Column="4" Text="{Binding ReadyMark}" Foreground="#167442" FontSize="21" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Ready. Press Enter to run."/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="Empty" VerticalAlignment="Center" Margin="14,0">
          <TextBlock x:Name="EmptyTitle" Text="Your next thing, a few words away." FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="EmptyDetail" Text="Search an app or file. Pin your favorites to keep them here." Foreground="{StaticResource Muted}" Margin="0,9,0,20" TextWrapping="Wrap"/>
          <WrapPanel><Button Content="the pdf I just downloaded" Click="ExampleClick"/><Button Content="files I modified today" Click="ExampleClick"/></WrapPanel>
        </StackPanel>
      </Grid>
      <DockPanel Grid.Row="4" x:Name="GroupBar" Visibility="Collapsed" Margin="0,6,0,5"><TextBlock x:Name="GroupLabel" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Review group" Click="ReviewGroupClick"/><Button Content="Save workspace" Click="SaveWorkspaceClick"/><Button Content="Open group" Click="OpenGroupClick"/></StackPanel></DockPanel>
      <Grid Grid.Row="5" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" Text="Local search ready" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Ctrl K  Actions" Click="ActionsClick" Padding="7,4" FontSize="11"/></Grid>
    </Grid>
  </Border>
</Window>
