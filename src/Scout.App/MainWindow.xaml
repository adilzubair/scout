<Window x:Class="Scout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scout" Width="704" Height="420" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnKeyDown" Background="{StaticResource Canvas}">
  <Window.Resources>
    <Style x:Key="SuggestionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Margin" Value="0,2"/>
    </Style>
  </Window.Resources>
  <Border x:Name="PanelShell" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Rim}" BorderThickness="1" CornerRadius="12">
    <Grid x:Name="PanelContent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="25,19,21,15" Background="Transparent" MouseLeftButtonDown="DragHeader">
        <Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Path Data="M 16,9 A 7,7 0 1 1 2,9 A 7,7 0 1 1 16,9 M 14,14 L 21,21" Stroke="{StaticResource Muted}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Width="24" Height="24"/>
        <Grid Grid.Column="1">
          <TextBox x:Name="Query" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="25" BorderThickness="0" Background="Transparent" Padding="0,5" TextChanged="QueryChanged" AutomationProperties.Name="Search apps, files and links"/>
          <TextBlock x:Name="Placeholder" Text="Search anything…" FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{StaticResource Muted}" FontSize="25" Margin="0,5" IsHitTestVisible="False"/>
        </Grid>
        <Button x:Name="ClearQuery" Grid.Column="2" Style="{StaticResource QuietButton}" Visibility="Collapsed" Padding="8" Margin="8,0,4,0" VerticalAlignment="Center" Click="ClearQueryClick" AutomationProperties.Name="Clear search" ToolTip="Clear search"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11"/></Button>
        <Button Grid.Column="3" Style="{StaticResource QuietButton}" Padding="0" VerticalAlignment="Center" Click="DismissClick" ToolTip="Dismiss Scout (Escape)" AutomationProperties.Name="Dismiss Scout"><Border Style="{StaticResource Keycap}" Padding="6,3"><TextBlock Text="esc"/></Border></Button>
      </Grid>
      <Grid Grid.Row="1" Margin="20,0,20,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="Scopes" Orientation="Horizontal">
          <Button Style="{StaticResource ScopeButton}" Content="All" Tag="0" Click="ScopeClick"/>
          <Button Style="{StaticResource ScopeButton}" Content="Files" Tag="1" Click="ScopeClick"/>
          <Button Style="{StaticResource ScopeButton}" Content="Apps" Tag="2" Click="ScopeClick"/>
          <Button Style="{StaticResource ScopeButton}" Content="Links" Tag="3" Click="ScopeClick"/>
          <Button Style="{StaticResource ScopeButton}" Content="Workspaces" Tag="4" Click="ScopeClick"/>
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource QuietButton}" Padding="8,6" Click="SettingsClick" ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Open settings"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15"/></Button>
      </Grid>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="28,5,28,9">
          <TextBlock x:Name="ResultsHeading" Text="Suggestions" Foreground="{StaticResource Muted}" FontSize="12"/>
          <TextBlock x:Name="ResultCount" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right" Visibility="Collapsed"/>
        </Grid>
        <ListBox Grid.Row="1" x:Name="Results" Background="Transparent" BorderThickness="0" Padding="0" Margin="12,0,12,12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionChanged="SelectionChanged" PreviewMouseLeftButtonDown="ResultMouseDown" MouseDoubleClick="OpenDoubleClick" AutomationProperties.Name="Search results">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="14,9"/>
              <Setter Property="Margin" Value="0,1"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/></Trigger>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource Selection}"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Evidence}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{Binding IconBackground}" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Grid><TextBlock Text="{Binding Glyph}" Visibility="{Binding GlyphVisibility}" FontFamily="Segoe Fluent Icons" Foreground="{Binding IconForeground}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock x:Name="ResultTitle" Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Marker}" FontFamily="Segoe Fluent Icons" FontSize="12" Margin="10,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="Pinned"/>
                <TextBlock Grid.Column="3" Text="{Binding KindLabel}" Margin="16,0,12,0" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="4" Visibility="{Binding MembershipVisibility}" IsChecked="{Binding Grouped, Mode=OneWay}" Click="MemberClick" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="Include in group"/>
                <Border Grid.Column="5" x:Name="ReturnKey" Style="{StaticResource Keycap}" HorizontalAlignment="Right" Padding="6,2" Visibility="Hidden" ToolTip="Press Enter to use this result"><TextBlock x:Name="ReturnGlyph" Text="↵" FontSize="14"/></Border>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="ReturnKey" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding IsReady}" Value="True"><Setter TargetName="ReturnGlyph" Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger>
                <DataTrigger Binding="{Binding KindLabel}" Value="Calculator"><Setter TargetName="ResultTitle" Property="FontSize" Value="30"/><Setter TargetName="ResultTitle" Property="FontWeight" Value="Medium"/></DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" x:Name="Empty" VerticalAlignment="Center" Margin="26,5,26,18">
          <TextBlock x:Name="EmptyTitle" Text="What can we help you find?" FontSize="19" FontWeight="Medium" Margin="0,0,0,6"/>
          <TextBlock x:Name="EmptyDetail" Text="An app, a file, or a few words to get started." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,15"/>
          <StackPanel x:Name="Examples" Margin="-12,0,-8,0">
            <Button Style="{StaticResource SuggestionButton}" Click="ExampleClick" Tag="the pdf I just downloaded" AutomationProperties.Name="Search for the PDF I just downloaded"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="the pdf I just downloaded"/></Grid></Button>
            <Button Style="{StaticResource SuggestionButton}" Click="ExampleClick" Tag="files I modified today" AutomationProperties.Name="Search for files modified today"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="files I modified today"/></Grid></Button>
            <Button Style="{StaticResource SuggestionButton}" Click="ExampleClick" Tag="15% of 240" AutomationProperties.Name="Calculate 15 percent of 240"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8EF;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="15% of 240"/></Grid></Button>
          </StackPanel>
        </StackPanel>
      </Grid>
      <Border Grid.Row="3" x:Name="GroupBar" Visibility="Collapsed" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="24,10">
        <DockPanel><TextBlock x:Name="GroupLabel" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Review group" Click="ReviewGroupClick" Style="{StaticResource QuietButton}" FontSize="12"/><Button Content="Save workspace" Click="SaveWorkspaceClick" Style="{StaticResource QuietButton}" Margin="4,0,8,0" FontSize="12"/><Button Content="Open group" Click="OpenGroupClick" Style="{StaticResource PrimaryButton}" FontSize="12"/></StackPanel></DockPanel>
      </Border>
      <Border Grid.Row="4" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="24,10,19,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <Path Data="M 14,2 L 10,12 L 2,16 L 6,6 Z M 6,6 L 10,12" Stroke="{StaticResource Muted}" StrokeThickness="1.2" StrokeLineJoin="Round" Width="17" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="Status" Text="Scout" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="330" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          </StackPanel>
          <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel x:Name="ResultHints" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,13,0">
              <TextBlock x:Name="PrimaryActionHint" Text="Open" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,7,0" VerticalAlignment="Center"/><Border Style="{StaticResource Keycap}"><TextBlock Text="↵" FontSize="12"/></Border>
            </StackPanel>
            <Border Background="{StaticResource Divider}" Width="1" Height="15" Margin="0,0,12,0"/>
            <Button x:Name="ActionsButton" Click="ActionsClick" Style="{StaticResource QuietButton}" Padding="3,2" AutomationProperties.Name="Result actions">
              <StackPanel Orientation="Horizontal"><TextBlock Text="Actions" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/><Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl K"/></Border></StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
